---
// /work/ index content, styled like the notes index (PostsIndex + PostCard):
// a standalone header card, then one linkable card per project.
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import { Icon } from 'astro-icon/components'

interface Props {
  lang: Language
  projects: Array<{
    slug: string
    title: string
    description: string
    category: string
    date?: string
    tech?: string[]
  }>
}

const { lang, projects } = Astro.props
const ui = getUI(lang)
const base = lang === 'th' ? '/th' : ''
---

<section class="card-base mb-4 px-6 py-8 md:px-9 md:py-10">
  <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary)]">{ui.workEyebrow}</p>
  <h1 class="text-3xl font-bold leading-tight text-90 md:text-4xl">{ui.workTitle}</h1>
  <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-75">{ui.workSubtitle}</p>
</section>

<section class="flex flex-col gap-4" aria-label={ui.workEyebrow}>
  {projects.length > 0 ? projects.map((project, index) => (
    <div
      class="card-base relative flex w-full flex-col rounded-[var(--radius-large)] overflow-hidden"
      style={`animation-delay: ${150 + index * 50}ms`}
    >
      <div class="relative w-full pl-6 md:pl-9 pr-6 md:pr-[calc(52px_+_12px)] pt-6 md:pt-7 pb-6">
        <a
          href={`${base}/work/${project.slug}/`}
          class="transition group w-full block font-bold mb-3 text-3xl text-90
                 hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
                 active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
                 before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                 before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block"
        >
          {project.title}
          <Icon class="inline text-[2rem] text-[var(--primary)] md:hidden translate-y-0.5 absolute" name="material-symbols:chevron-right-rounded"></Icon>
          <Icon class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0" name="material-symbols:chevron-right-rounded"></Icon>
        </a>

        <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium text-50">
          {project.category && <span>{project.category}</span>}
          {project.date && <span>{project.date}</span>}
          {project.tech && project.tech.length > 0 && (
            <span class="hidden md:inline whitespace-nowrap">{project.tech.slice(0, 4).join(' / ')}</span>
          )}
        </div>

        <p class="text-75">{project.description}</p>

        {project.tech && project.tech.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <span class="btn-regular h-8 text-sm px-3 rounded-lg">{tech}</span>
            ))}
          </div>
        )}
      </div>

      <a
        href={`${base}/work/${project.slug}/`}
        aria-label={project.title}
        class="!hidden md:!flex btn-regular w-[3.25rem] absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--enter-btn-bg)]
               hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95"
      >
        <Icon name="material-symbols:chevron-right-rounded" class="transition text-[var(--primary)] text-4xl mx-auto"></Icon>
      </a>
    </div>
  )) : (
    <div class="card-base p-8 text-center text-75">{ui.workEmptyBody}</div>
  )}
</section>
