---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import { PUBLIC_CONTACT_URL } from '@/data/types'
import Reveal from '@/components/motion/Reveal.astro'
import Button from '@/components/ui/Button.astro'

interface Props {
  lang: Language
}
const { lang } = Astro.props
const ui = getUI(lang)
const base = lang === 'en' ? '' : '/th'
---

<section id="home" class="mx-auto grid max-w-[1200px] gap-10 px-5 pt-16 pb-12 sm:px-8 md:grid-cols-[1.15fr_0.85fr] md:items-center md:pt-24">
  <div>
    <Reveal>
      <span class="eyebrow">{ui.heroEyebrow}</span>
    </Reveal>
    <Reveal delay={80}>
      <h1 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl">
        {ui.heroTitle}
      </h1>
    </Reveal>
    <Reveal delay={160}>
      <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-muted">{ui.heroBody}</p>
    </Reveal>
    <Reveal delay={240}>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={`${base}/#work`}>{ui.heroPrimaryCta}</Button>
        <Button href={PUBLIC_CONTACT_URL} variant="secondary" external={true}>
          {ui.heroSecondaryCta}
        </Button>
      </div>
    </Reveal>
  </div>

  <Reveal delay={320}>
    <div class="card p-6 sm:p-8">
      <p class="eyebrow">System</p>
      <ul class="mt-5 space-y-4">
        {ui.heroMeta.map((item) => (
          <li class="flex items-start justify-between gap-4 border-b border-line pb-4 last:border-0 last:pb-0">
            <span class="text-sm font-medium text-ink">{item.label}</span>
            <span class="font-mono text-sm text-muted">{item.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </Reveal>
</section>
