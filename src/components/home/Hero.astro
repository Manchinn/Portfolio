---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import Reveal from '@/components/motion/Reveal.astro'
import Button from '@/components/ui/Button.astro'

interface Props {
  lang: Language
}
const { lang } = Astro.props
const ui = getUI(lang)
const base = lang === 'en' ? '' : '/th'
---

<section id="home" class="w-full border-b border-dashed border-line px-[var(--hw-gutter)] py-[calc(88*var(--u))]">
  <div class="grid gap-[calc(48*var(--u))] lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
    <div>
      <Reveal>
        <span class="eyebrow">{ui.heroEyebrow}</span>
      </Reveal>
      <Reveal delay={80}>
        <h1 class="display mt-5 text-[var(--hw-text-display)] text-ink">
          {ui.heroTitle}
        </h1>
      </Reveal>
      <Reveal delay={160}>
        <p class="mt-6 max-w-[58ch] text-[var(--hw-text-body)] leading-relaxed text-muted">{ui.heroBody}</p>
      </Reveal>
      <Reveal delay={240}>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={`${base}/notes/#notes`}>{ui.heroPrimaryCta}</Button>
        </div>
      </Reveal>
    </div>

    <Reveal delay={320}>
      <div class="lg:justify-self-end lg:text-right">
        <span class="eyebrow">{ui.heroSystemLabel}</span>
        <dl class="mt-3 space-y-2">
          {ui.heroMeta.map((item) => (
            <div class="flex items-baseline justify-between gap-6 lg:justify-end">
              <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted">{item.label}</dt>
              <dd class="font-mono text-sm text-ink">{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Reveal>
  </div>
</section>
