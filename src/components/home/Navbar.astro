---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import MobileMenu from '@/components/ui/MobileMenu.tsx'

interface Props {
  lang: Language
  alternateHref?: string
}
const { lang, alternateHref: alternateHrefProp } = Astro.props
const ui = getUI(lang)
const base = lang === 'en' ? '' : '/th'
const links = [
  { href: `${base}/#home`, label: ui.nav.home },
  { href: `${base}/#work`, label: ui.nav.work },
  { href: `${base}/notes/`, label: ui.nav.notes },
  { href: `${base}/#capabilities`, label: ui.nav.capabilities },
  { href: `${base}/#contact`, label: ui.nav.contact },
]
const alternateHref = alternateHrefProp ?? (lang === 'en' ? '/th' : '/')
---

<header class="sticky top-0 z-50 border-b border-dashed border-line bg-white">
  <nav class="flex h-[64px] w-full items-center justify-between px-[var(--hw-gutter)]">
    <a
      href={`${base}/#home`}
      class="flex items-center gap-2.5 font-mono text-sm font-bold uppercase tracking-[0.08em] text-ink"
      aria-label={ui.brand}
    >
      <span class="grid h-6 w-6 place-items-center border border-accent text-[10px] text-accent">C</span>
      {ui.brand}
    </a>

    <ul class="hidden items-center gap-5 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-target={link.href.split('#')[1]}
            class="font-mono text-xs uppercase tracking-[0.12em] text-muted hover:text-ink"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="ml-1">
        <a
          href={alternateHref}
          class="border border-line-strong px-3 py-1.5 font-mono text-xs uppercase tracking-[0.12em] text-ink transition hover:border-accent-strong"
        >
          {lang === 'en' ? 'ไทย' : 'EN'}
        </a>
      </li>
    </ul>

    <MobileMenu
      client:load
      links={links}
      alternateHref={alternateHref}
      alternateLabel={lang === 'en' ? 'ไทย' : 'EN'}
    />
  </nav>
</header>
