---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'

interface Article {
  slug: string
  title: string
  excerpt: string
  category: string
  readTime: string
}

interface Props {
  lang: Language
  articles: Article[]
}
const { lang, articles } = Astro.props
const ui = getUI(lang)
const articlePath = (slug: string) => (lang === 'en' ? `/article/${slug}/` : `/th/article/${slug}/`)
---

<section id="articles" class="mx-auto max-w-[1280px] px-5 py-16 sm:px-8">
  <SectionLabel>{ui.articlesEyebrow}</SectionLabel>
  <SectionHeading as="h2" class="mt-4">
    {ui.articlesTitle}
  </SectionHeading>
  <p class="mt-4 max-w-[60ch] text-portfolio-muted">{ui.articlesSubtitle}</p>

  <ol class="mt-10 divide-y divide-portfolio-line">
    {articles.map((article, i) => (
      <li>
        <a href={articlePath(article.slug)} class="group grid gap-3 py-6 sm:grid-cols-[3rem_1fr_auto] sm:items-start">
          <span class="font-mono text-sm font-semibold text-portfolio-accent">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-xl font-semibold text-portfolio-ink group-hover:text-portfolio-accent">
              {article.title}
            </h3>
            <p class="mt-2 text-portfolio-muted">{article.excerpt}</p>
          </div>
          <div class="sm:text-right">
            <p class="pixel-label font-pixel">{article.category}</p>
            <p class="mt-2 font-mono text-xs text-portfolio-muted">{article.readTime}</p>
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>
