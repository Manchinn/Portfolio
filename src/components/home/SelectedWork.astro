---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'

interface Project {
  title: string
  description: string
  tech: string[]
  date: string
  category: string
  caseStudy: { problem: string; built: string; result: string }
  highlights: string[]
}

interface Props {
  lang: Language
  project: Project
}
const { lang, project } = Astro.props
const ui = getUI(lang)
const caseRows = [
  { index: '01', label: ui.problem, text: project.caseStudy.problem },
  { index: '02', label: ui.built, text: project.caseStudy.built },
  { index: '03', label: ui.result, text: project.caseStudy.result },
]
---

<section id="work" class="mx-auto max-w-[1280px] px-5 py-16 sm:px-8">
  <SectionLabel>{ui.selectedEyebrow}</SectionLabel>
  <SectionHeading as="h2" class="mt-4">
    {ui.selectedTitle}
  </SectionHeading>
  <p class="mt-4 max-w-[60ch] text-portfolio-muted">{ui.selectedSubtitle}</p>

  <div class="mt-10 grid gap-6 md:grid-cols-[0.9fr_1.1fr] md:gap-8">
    <div class="hard-frame bg-portfolio-surface p-6 sm:p-8">
      <span class="pixel-label font-pixel">{project.category}</span>
      <h3 class="mt-4 text-2xl font-semibold text-portfolio-ink">{project.title}</h3>
      <p class="mt-3 text-portfolio-muted">{project.description}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        {project.tech.map((t) => (
          <span class="hairline rounded-portfolio-sm bg-portfolio-surface-soft px-2.5 py-1 font-mono text-xs text-portfolio-ink">
            {t}
          </span>
        ))}
      </div>

      <ul class="mt-6 space-y-2">
        {project.highlights.map((h) => (
          <li class="flex items-start gap-2 text-sm text-portfolio-ink">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-portfolio-accent" aria-hidden="true" />
            {h}
          </li>
        ))}
      </ul>

      <p class="mt-6 font-mono text-xs uppercase tracking-[0.08em] text-portfolio-muted">{project.date}</p>
    </div>

    <div class="hairline rounded-portfolio-sm bg-portfolio-surface p-6 sm:p-8">
      <p class="pixel-label font-pixel">{ui.proofLabel}</p>
      <ol class="mt-6 space-y-6">
        {caseRows.map((row) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4">
            <span class="font-mono text-sm font-semibold text-portfolio-accent">{row.index}</span>
            <div>
              <p class="font-medium text-portfolio-ink">{row.label}</p>
              <p class="mt-1 text-sm leading-relaxed text-portfolio-muted">{row.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
