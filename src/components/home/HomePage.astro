---
import type { Language } from '@/i18n/ui'
import Navbar from '@/components/home/Navbar.astro'
import Hero from '@/components/home/Hero.astro'
import Work from '@/components/home/Work.astro'
import Capabilities from '@/components/home/Capabilities.astro'
import Footer from '@/components/home/Footer.astro'
import ScrollMotion from '@/components/motion/ScrollMotion.astro'

interface Project {
  slug: string
  title: string
  description: string
  tech: string[]
  category: string
  caseStudy?: { problem: string; built: string; result: string }
}

interface Props {
  lang: Language
  projects: Project[]
}
const { lang, projects } = Astro.props
---

<div class="flex min-h-screen flex-col">
  <Navbar lang={lang} />
  <main class="flex-1">
    <Hero lang={lang} />
    <Work lang={lang} projects={projects} />
    <Capabilities lang={lang} />
  </main>
  <Footer lang={lang} />
</div>

<ScrollMotion />
