---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'

interface Project {
  slug: string
  title: string
  description: string
  tech: string[]
  category: string
  caseStudy?: { problem: string; built: string; result: string }
}

interface Props {
  lang: Language
  projects: Project[]
}
const { lang, projects } = Astro.props
const ui = getUI(lang)
const labels = ui.workCaseStudy
// The work-detail route is retired, so each card is a non-navigational proof
// panel (problem → built → result) scannable in place. No /work/:slug link.
---

<section id="work" class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8">
  <SectionLabel>{ui.workEyebrow}</SectionLabel>
  <SectionHeading as="h2" class="mt-4">
    {ui.workTitle}
  </SectionHeading>
  <p class="mt-4 max-w-[64ch] text-muted">{ui.workSubtitle}</p>

  {projects.length > 0 ? (
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {projects.map((p) => (
        <article class="card card-hover group flex flex-col p-8">
          <p class="eyebrow">{p.category}</p>
          <h3 class="mt-3 text-xl font-semibold text-ink group-hover:text-accent">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>

          {p.caseStudy && (
            <dl class="mt-5 space-y-3 border-t border-line pt-5 text-sm">
              {[
                { label: labels.problem, text: p.caseStudy.problem },
                { label: labels.built, text: p.caseStudy.built },
                { label: labels.result, text: p.caseStudy.result },
              ].map((row) => (
                <div class="grid gap-1">
                  <dt class="font-mono text-xs uppercase tracking-[0.12em] text-accent">{row.label}</dt>
                  <dd class="leading-relaxed text-muted">{row.text}</dd>
                </div>
              ))}
            </dl>
          )}

          <div class="mt-5 flex flex-wrap gap-2">
            {p.tech.map((t) => (
              <span class="rounded-md bg-surface-soft px-2.5 py-1 font-mono text-xs text-muted">{t}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="mt-10 card border-dashed p-10 text-center sm:p-14">
      <h3 class="text-xl font-semibold text-ink">{ui.workEmptyTitle}</h3>
      <p class="mx-auto mt-3 max-w-[46ch] text-muted">{ui.workEmptyBody}</p>
    </div>
  )}
</section>
