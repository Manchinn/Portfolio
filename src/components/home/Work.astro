---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'

interface Project {
  slug: string
  title: string
  description: string
  tech: string[]
  category: string
  caseStudy?: { problem: string; built: string; result: string }
}

interface Props {
  lang: Language
  projects: Project[]
}
const { lang, projects } = Astro.props
const ui = getUI(lang)
const labels = ui.workCaseStudy
// Work-detail route is retired, so each project is a flat non-navigational
// "machine readout" row (figure placeholder | story | system data) scannable
// in place. No /work/:slug link.
---

<section id="work" class="w-full px-[var(--hw-gutter)] py-[calc(96*var(--u))]">
  <div data-reveal-group>
    <div data-reveal-item>
      <SectionLabel>{ui.workEyebrow}</SectionLabel>
    </div>
    <div data-reveal-item>
      <SectionHeading as="h2" class="mt-4">
    {ui.workTitle}
      </SectionHeading>
    </div>
    <p data-reveal-item class="mt-4 max-w-[60ch] text-[var(--hw-text-body)] text-muted">{ui.workSubtitle}</p>
  </div>

  {projects.length > 0 ? (
    <div data-reveal-group class="mt-6">
      {projects.map((p, i) => (
        <article data-reveal-item class="project-row grid gap-[calc(24*var(--u))] border-b border-dashed border-line py-[calc(40*var(--u))] last:border-b-0 md:grid-cols-[0.8fr_1.35fr_0.85fr] md:items-start md:gap-[calc(40*var(--u))]">
          {/* figure placeholder — swap for a real image later */}
          <figure class="placeholder-fig">
            <figcaption>{ui.workFigPlaceholder}</figcaption>
          </figure>

          <div>
            <p class="eyebrow">{p.category}</p>
            <h3 class="display mt-3 text-[calc(22*var(--u))] text-ink">{p.title}</h3>
            <p class="mt-3 text-[var(--hw-text-body)] leading-relaxed text-muted">{p.description}</p>

            {p.caseStudy && (
              <dl class="mt-5 space-y-3 border-t border-dashed border-line pt-4">
                <div>
                  <dt class="font-mono text-xs uppercase tracking-[0.12em] text-accent">{labels.problem}</dt>
                  <dd class="mt-1 text-[var(--hw-text-body)] leading-relaxed text-muted">{p.caseStudy.problem}</dd>
                </div>
                <div>
                  <dt class="font-mono text-xs uppercase tracking-[0.12em] text-accent">{labels.built}</dt>
                  <dd class="mt-1 text-[var(--hw-text-body)] leading-relaxed text-muted">{p.caseStudy.built}</dd>
                </div>
                <div>
                  <dt class="font-mono text-xs uppercase tracking-[0.12em] text-accent">{labels.result}</dt>
                  <dd class="mt-1 text-[var(--hw-text-body)] leading-relaxed text-muted">{p.caseStudy.result}</dd>
                </div>
              </dl>
            )}
          </div>

          {/* system readout */}
          <div class="lg:justify-self-end lg:text-right">
            <dl class="font-mono text-xs uppercase tracking-[0.1em]">
              <div class="flex justify-between gap-8 lg:justify-end">
                <dt class="text-muted">Ref</dt>
                <dd class="text-ink">P-{String(i + 1).padStart(2, '0')}</dd>
              </div>
              <div class="flex justify-between gap-8 lg:justify-end">
                <dt class="text-muted">Tech</dt>
                <dd class="text-ink">×{p.tech.length}</dd>
              </div>
              <div class="flex justify-between gap-8 lg:justify-end">
                <dt class="text-muted">Case</dt>
                <dd class="text-ink">✓</dd>
              </div>
            </dl>

            {i % 3 === 0 && (
              <svg viewBox="0 0 32 32" class="project-mark mt-4 text-accent" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="16" cy="16" r="12" />
                <ellipse cx="16" cy="16" rx="12" ry="5" />
                <path d="M4 16h24" />
              </svg>
            )}
            {i % 3 === 1 && (
              <svg viewBox="0 0 32 32" class="project-mark mt-4 text-accent" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M16 2 30 16 16 30 2 16Z" />
                <path d="M16 8 24 16 16 24 8 16Z" />
              </svg>
            )}
            {i % 3 === 2 && (
              <svg viewBox="0 0 32 32" class="project-mark mt-4 text-accent" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M4 22c3-8 7-8 10 0s7 8 10 0" />
                <path d="M4 10c3-4 7-4 10 0s7 4 10 0" />
              </svg>
            )}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="mt-10 border border-dashed border-line p-10 text-center sm:p-14">
      <h3 class="display text-xl text-ink">{ui.workEmptyTitle}</h3>
      <p class="mx-auto mt-3 max-w-[46ch] text-muted">{ui.workEmptyBody}</p>
    </div>
  )}
</section>
