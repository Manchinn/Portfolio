---
// Contact section — posts to the `submit-contact` Supabase Edge Function.
// Anonymous, no tracking: the submission row stores only what the visitor
// typed (plus locale) so the owner can reply. RLS restricts inserts to
// status='new' and reads to editors.
import type { Language } from '@/i18n/ui'

interface Props {
  lang: Language
}
const { lang } = Astro.props

const t =
  lang === 'th'
    ? {
        eyebrow: 'ติดต่อ',
        title: 'คุยกันเรื่องงานกันไหม?',
        subtitle: 'ฝากข้อความไว้แล้วจะตอบกลับทางอีเมล — ไม่มีการติดตามผู้เยี่ยมชม',
        name: 'ชื่อ',
        email: 'อีเมล',
        company: 'บริษัท (ไม่บังคับ)',
        budget: 'งบประมาณ (ไม่บังคับ)',
        message: 'ข้อความ',
        send: 'ส่งข้อความ',
        sending: 'กำลังส่ง…',
        ok: 'ส่งแล้ว — ขอบคุณครับ จะตอบกลับเร็วที่สุด',
        fail: 'ส่งไม่สำเร็จ ลองอีกครั้งภายหลัง',
      }
    : {
        eyebrow: 'Contact',
        title: 'Start a conversation.',
        subtitle: 'Leave a message and I will reply by email — no visitor tracking.',
        name: 'Name',
        email: 'Email',
        company: 'Company (optional)',
        budget: 'Budget (optional)',
        message: 'Message',
        send: 'Send message',
        sending: 'Sending…',
        ok: 'Sent — thanks, I will get back to you soon.',
        fail: 'Could not send — please try again later.',
      }

---

<section id="contact" class="mb-4">
  <div class="card-base px-6 py-8 md:px-9 md:py-10">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary)]">{t.eyebrow}</p>
    <h2 class="text-2xl font-bold text-90 md:text-3xl">{t.title}</h2>
    <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-75">{t.subtitle}</p>

    <form id="contact-form" data-endpoint="https://bzmxvbuvlmzpqjzijbud.supabase.co/functions/v1/submit-contact" class="mt-6 grid max-w-[640px] gap-4" novalidate>
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5">
          <span class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{t.name} *</span>
          <input required maxlength="200" name="name" type="text" autocomplete="name"
            class="rounded-lg border border-[var(--line-divider)] bg-transparent px-3 py-2 text-sm text-90 outline-none focus:border-[var(--primary)]" />
        </label>
        <label class="grid gap-1.5">
          <span class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{t.email} *</span>
          <input required maxlength="320" name="email" type="email" autocomplete="email"
            class="rounded-lg border border-[var(--line-divider)] bg-transparent px-3 py-2 text-sm text-90 outline-none focus:border-[var(--primary)]" />
        </label>
        <label class="grid gap-1.5">
          <span class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{t.company}</span>
          <input maxlength="200" name="company" type="text" autocomplete="organization"
            class="rounded-lg border border-[var(--line-divider)] bg-transparent px-3 py-2 text-sm text-90 outline-none focus:border-[var(--primary)]" />
        </label>
        <label class="grid gap-1.5">
          <span class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{t.budget}</span>
          <input maxlength="100" name="budget" type="text"
            class="rounded-lg border border-[var(--line-divider)] bg-transparent px-3 py-2 text-sm text-90 outline-none focus:border-[var(--primary)]" />
        </label>
      </div>
      <label class="grid gap-1.5">
        <span class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{t.message} *</span>
        <textarea required maxlength="5000" name="message" rows="5"
          class="rounded-lg border border-[var(--line-divider)] bg-transparent px-3 py-2 text-sm text-90 outline-none focus:border-[var(--primary)]"></textarea>
      </label>
      <div class="flex items-center gap-4">
        <button type="submit" data-label={t.send} data-busy={t.sending} data-ok={t.ok} data-fail={t.fail}
          class="btn-regular h-11 rounded-lg px-5 font-bold">{t.send}</button>
        <p id="contact-status" class="text-sm text-75" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  if (form) {
    const status = document.getElementById('contact-status')!
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!form.reportValidity()) return
      const data = new FormData(form)
      const payload = {
        name: data.get('name'),
        email: data.get('email'),
        company: data.get('company'),
        budget: data.get('budget'),
        message: data.get('message'),
        locale: document.documentElement.lang === 'th' ? 'th' : 'en',
        website: data.get('website'),
      }
      button.disabled = true
      button.textContent = button.dataset.busy ?? ''
      status.textContent = ''
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
        if (!res.ok) throw new Error(String(res.status))
        form.reset()
        status.textContent = button.dataset.ok ?? 'Sent.'
      } catch {
        status.textContent = button.dataset.fail ?? 'Failed.'
      } finally {
        button.disabled = false
        button.textContent = button.dataset.label ?? ''
      }
    })
  }
</script>
