---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import { PUBLIC_CONTACT_URL } from '@/data/types'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import Button from '@/components/ui/Button.astro'

interface Props {
  lang: Language
}
const { lang } = Astro.props
const ui = getUI(lang)
---

<section id="contact" class="w-full px-[var(--hw-gutter)] py-[calc(96*var(--u))]">
  <div class="card grid gap-[calc(32*var(--u))] p-[calc(40*var(--u))] lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
    <div>
      <SectionLabel>{ui.contactEyebrow}</SectionLabel>
      <h2 class="display mt-4 text-[calc(30*var(--u))] text-ink">{ui.contactTitle}</h2>
      <p class="mt-4 max-w-[52ch] leading-relaxed text-muted">{ui.contactBody}</p>
    </div>
    <div class="flex flex-col items-start gap-4">
      <Button href={PUBLIC_CONTACT_URL} external={true}>
        {ui.contactAction}
      </Button>
      <p class="text-xs leading-relaxed text-muted">{ui.contactNotice}</p>
    </div>
  </div>
</section>
