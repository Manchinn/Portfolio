---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'

interface Props {
  lang: Language
}
const { lang } = Astro.props
const ui = getUI(lang)
const base = lang === 'en' ? '' : '/th'
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-4 px-5 py-10 sm:flex-row sm:items-center sm:px-8">
    <a href={`${base}/#home`} class="flex items-center gap-2.5 font-semibold text-ink">
      <span class="grid h-7 w-7 place-items-center rounded-md bg-accent text-xs font-bold text-on-accent">C</span>
      {ui.brand}
    </a>
    <p class="text-sm text-muted">{ui.footer}</p>
    <div class="flex items-center gap-5 text-sm text-muted">
      <a href={`${base}/#work`} class="hover:text-ink">{ui.nav.work}</a>
      <a href={`${base}/#contact`} class="hover:text-ink">{ui.nav.contact}</a>
    </div>
  </div>
</footer>
