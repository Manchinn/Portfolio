---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'

interface Props {
  lang: Language
}
const { lang } = Astro.props
const ui = getUI(lang)
const base = lang === 'en' ? '' : '/th'
---

<footer class="border-t border-dashed border-line bg-surface">
  <div class="flex w-full flex-col items-start justify-between gap-4 px-[var(--hw-gutter)] py-[calc(48*var(--u))] sm:flex-row sm:items-center">
    <a href={`${base}/#home`} class="flex items-center gap-2.5 font-mono text-sm font-bold uppercase tracking-[0.08em] text-ink">
      <span class="grid h-6 w-6 place-items-center border border-accent text-[10px] text-accent">C</span>
      {ui.brand}
    </a>
    <p class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{ui.footer}</p>
    <div class="flex items-center gap-5 font-mono text-xs uppercase tracking-[0.1em] text-muted">
      <a href={`${base}/#work`} class="hover:text-ink">{ui.nav.work}</a>
      <a href={`${base}/posts/`} class="hover:text-ink">{ui.nav.notes}</a>
    </div>
  </div>
</footer>
