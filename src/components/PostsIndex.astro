---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import { entrySlug } from '@/content.config'
import PostCard from '@/components/PostCard.astro'
import Pagination from '@/components/control/Pagination.astro'

interface Props {
  lang: Language
  posts: CollectionEntry<'articles'>[]
  currentPage?: number
  lastPage?: number
  basePath?: string
  title?: string
  subtitle?: string
}

const { lang, posts, currentPage = 1, lastPage = 1, basePath = '/posts/', title, subtitle } = Astro.props
const ui = getUI(lang)
const base = lang === 'th' ? '/th' : ''
const pageTitle = title ?? ui.notesTitle
const pageSubtitle = subtitle ?? ui.notesSubtitle
---

<section class="card-base mb-4 px-6 py-8 md:px-9 md:py-10">
  <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary)]">{ui.notesEyebrow}</p>
  <h1 class="text-3xl font-bold leading-tight text-90 md:text-4xl">{pageTitle}</h1>
  <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-75">{pageSubtitle}</p>
</section>
<section class="flex flex-col gap-4" aria-label={ui.notesEyebrow}>
  {posts.length > 0 ? posts.map((note, index) => (
    <PostCard
      entry={note}
      title={note.data.title}
      tags={note.data.tags}
      category={note.data.category}
      published={new Date(note.data.publishedAt)}
      updated={note.data.updatedAt ? new Date(note.data.updatedAt) : undefined}
      url={`${base}/posts/${entrySlug(note.id)}/`}
      image=""
      description={note.data.excerpt}
      draft={note.data.draft}
      lang={lang}
      style={`animation-delay: ${150 + index * 50}ms`}
    />
  )) : (
    <div class="card-base p-8 text-center text-75">{ui.notesEmptyBody}</div>
  )}
</section>
{lastPage > 1 && (
  <Pagination currentPage={currentPage} lastPage={lastPage} basePath={basePath} class="mt-8" />
)}
