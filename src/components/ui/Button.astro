---
interface Props {
  href: string
  variant?: 'primary' | 'secondary'
  external?: boolean
}
const { href, variant = 'primary', external = false } = Astro.props
const base =
  'inline-flex min-h-[44px] items-center justify-center gap-2 border px-5 py-2.5 font-mono text-sm uppercase tracking-[0.1em] transition hover:-translate-y-px active:translate-y-px'
const variantClass =
  variant === 'primary'
    ? 'border-accent bg-accent text-on-accent hover:border-accent-strong hover:bg-accent-strong'
    : 'border-line-strong text-ink hover:border-accent-strong'
---

<a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class={`${base} ${variantClass}`}>
  <slot />
</a>
