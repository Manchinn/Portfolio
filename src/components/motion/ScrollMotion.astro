<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import Lenis from 'lenis'

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (!reduceMotion.matches) {
    gsap.registerPlugin(ScrollTrigger)

    const lenis = new Lenis({
      autoRaf: false,
      smoothWheel: true,
    })

    let frameId = 0
    const frame = (time: number) => {
      lenis.raf(time)
      frameId = requestAnimationFrame(frame)
    }

    lenis.on('scroll', ScrollTrigger.update)
    frameId = requestAnimationFrame(frame)

    const getHashTarget = (url: URL) => {
      if (!url.hash) return null

      try {
        return document.getElementById(decodeURIComponent(url.hash.slice(1)))
      } catch {
        return null
      }
    }

    document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) return

        const url = new URL(link.href, window.location.href)
        if (
          url.origin !== window.location.origin ||
          url.pathname !== window.location.pathname ||
          url.search !== window.location.search
        ) return

        const target = getHashTarget(url)
        if (!target) return

        event.preventDefault()
        history.pushState(null, '', `${url.pathname}${url.search}${url.hash}`)
        lenis.scrollTo(target, { offset: 0, duration: 0.8 })
      })
    })

    document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach((group) => {
      const items = group.querySelectorAll<HTMLElement>('[data-reveal-item]')

      if (!items.length) return

      gsap.from(items, {
        opacity: 0,
        y: 12,
        duration: 0.55,
        ease: 'power2.out',
        stagger: 0.08,
        clearProps: 'transform',
        scrollTrigger: {
          trigger: group,
          start: 'top 84%',
          once: true,
        },
      })
    })

    document.querySelectorAll<HTMLAnchorElement>('[data-nav-target]').forEach((link) => {
      const targetId = link.dataset.navTarget
      const target = targetId ? document.getElementById(targetId) : null
      if (!target) return

      ScrollTrigger.create({
        trigger: target,
        start: 'top 35%',
        end: 'bottom 35%',
        toggleClass: { targets: link, className: 'is-active' },
      })
    })

    const scrollToInitialHash = () => {
      const target = getHashTarget(new URL(window.location.href))
      if (!target) return

      window.scrollTo({ top: 0, left: 0, behavior: 'auto' })
      lenis.scrollTo(target, { offset: 0, duration: 0.8 })
    }

    const refresh = () => {
      ScrollTrigger.refresh()
      scrollToInitialHash()
    }

    if (document.readyState === 'complete') {
      refresh()
    } else {
      window.addEventListener('load', refresh, { once: true })
    }

    window.addEventListener('popstate', scrollToInitialHash)
    const cleanup = () => {
      cancelAnimationFrame(frameId)
      lenis.destroy()
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill())
    }

    window.addEventListener('pagehide', cleanup, { once: true })
  }
</script>
