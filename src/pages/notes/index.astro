---
import { getCollection } from 'astro:content'
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import { entrySlug } from '@/content.config'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import PostCard from '@/components/PostCard.astro'

const lang: Language = 'en'
const ui = getUI(lang)
const notes = (await getCollection('articles', ({ id, data }) => id.startsWith('en/') && !data.draft))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
---

<MainGridLayout lang={lang} bannerEnabled={false} title={`${ui.notesEyebrow} - ${ui.brand}`} description={ui.notesSubtitle}>
  <section class="card-base mb-4 px-6 py-8 md:px-9 md:py-10">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary)]">{ui.notesEyebrow}</p>
    <h1 class="text-3xl font-bold leading-tight text-90 md:text-4xl">{ui.notesTitle}</h1>
    <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-75">{ui.notesSubtitle}</p>
  </section>
  <section class="flex flex-col gap-4" aria-label={ui.notesEyebrow}>
    {notes.length > 0 ? notes.map((note, index) => (
      <PostCard
        entry={note}
        title={note.data.title}
        tags={note.data.tags}
        category={note.data.category}
        published={new Date(note.data.publishedAt)}
        updated={note.data.updatedAt ? new Date(note.data.updatedAt) : undefined}
        url={`/notes/${entrySlug(note.id)}/`}
        image=""
        description={note.data.excerpt}
        draft={note.data.draft}
        lang={lang}
        style={`animation-delay: ${150 + index * 50}ms`}
      />
    )) : (
      <div class="card-base p-8 text-center text-75">{ui.notesEmptyBody}</div>
    )}
  </section>
</MainGridLayout>
