---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import { entrySlug } from '@/content.config'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import PostMeta from '@/components/PostMeta.astro'
import Markdown from '@/components/misc/Markdown.astro'

export async function getStaticPaths() {
  const notes = await getCollection('articles', ({ id, data }) => id.startsWith('en/') && !data.draft)
  return notes.map((note) => ({ params: { slug: entrySlug(note.id) }, props: { note } }))
}

type Props = { note: CollectionEntry<'articles'> }
const { note } = Astro.props
const lang: Language = 'en'
const ui = getUI(lang)
const { Content, headings } = await render(note)
---

<MainGridLayout lang={lang} title={note.data.title} description={note.data.excerpt} setOGTypeArticle headings={headings}>
  <article id="post-container" class="card-base px-6 py-7 md:px-9 md:py-9">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary)]">{note.data.category}</p>
    <h1 data-pagefind-body data-pagefind-meta="title" class="mb-4 text-3xl font-bold leading-tight text-90 md:text-5xl">{note.data.title}</h1>
    <PostMeta
      class="mb-6"
      published={new Date(note.data.publishedAt)}
      updated={note.data.updatedAt ? new Date(note.data.updatedAt) : undefined}
      tags={note.data.tags}
      category={note.data.category}
      lang={lang}
    />
    <div class="mb-7 border-b border-dashed border-[var(--line-divider)]"></div>
    <Markdown class="markdown-content">
      <Content />
    </Markdown>
    <div class="mt-8 border-t border-dashed border-[var(--line-divider)] pt-5">
      <a class="link text-sm font-medium" href="/notes/">{ui.notesBack}</a>
    </div>
  </article>
</MainGridLayout>
