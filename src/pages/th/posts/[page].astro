---
import { getCollection } from 'astro:content'
import type { Language } from '@/i18n/ui'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import PostsIndex from '@/components/PostsIndex.astro'

export async function getStaticPaths() {
  const PAGE_SIZE = 10
  const posts = (await getCollection('articles', ({ id, data }) => id.startsWith('th/') && !data.draft)).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
  const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE))
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => {
    const currentPage = index + 2
    return { params: { page: String(currentPage) }, props: { posts: posts.slice(index * PAGE_SIZE + PAGE_SIZE, currentPage * PAGE_SIZE), currentPage, lastPage } }
  })
}
const { posts, currentPage, lastPage } = Astro.props
const lang: Language = 'th'
---
<MainGridLayout lang={lang} bannerEnabled={false} title={`โพสต์ หน้า ${currentPage} - ชินกฤต`}>
  <PostsIndex lang={lang} posts={posts} currentPage={currentPage} lastPage={lastPage} basePath="/th/posts/" />
</MainGridLayout>
