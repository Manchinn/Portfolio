---
import { getCollection } from 'astro:content'
import type { Language } from '@/i18n/ui'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import PostsIndex from '@/components/PostsIndex.astro'

const lang: Language = 'th'
const posts = (await getCollection('articles', ({ id, data }) => id.startsWith('th/') && !data.draft))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
---
<MainGridLayout lang={lang} bannerEnabled={false} title="โพสต์ - ชินกฤต" description="โพสต์ บันทึก และ runbook ของชินกฤต">
  <PostsIndex lang={lang} posts={posts} basePath="/th/posts/" />
</MainGridLayout>
