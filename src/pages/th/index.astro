---
import { getCollection } from 'astro:content'
import type { Language } from '@/i18n/ui'
import PortfolioHome from '@/components/PortfolioHome.astro'

const lang: Language = 'th'
const projects = await getCollection('projects', ({ id }) => id.startsWith('th/'))
const notes = (await getCollection('articles', ({ id, data }) => id.startsWith('th/') && !data.draft))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
---

<PortfolioHome lang={lang} projects={projects} notes={notes} />
