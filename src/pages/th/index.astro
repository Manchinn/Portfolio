---
import type { Language } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import HomePage from '@/components/home/HomePage.astro'

// The projects content collection is defined but empty. The Work section
// renders a graceful empty state until project entries are added.
const projectData = [] as { slug: string; title: string; description: string; tech: string[]; category: string }[]

const lang: Language = 'th'
---

<BaseLayout lang={lang}>
  <HomePage lang={lang} projects={projectData} />
</BaseLayout>
