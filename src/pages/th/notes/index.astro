---
import { getCollection } from 'astro:content'
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import { entrySlug } from '@/content.config'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Navbar from '@/components/home/Navbar.astro'
import Footer from '@/components/home/Footer.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'

const lang: Language = 'th'
const ui = getUI(lang)
const notes = (await getCollection('articles', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
---

<BaseLayout lang={lang} title={`${ui.notesEyebrow} — ${ui.brand}`} description={ui.notesSubtitle}>
  <div class="flex min-h-screen flex-col">
    <Navbar lang={lang} alternateHref="/notes/" />
    <main class="flex-1">
      <section id="notes" data-reveal-group class="w-full border-b border-dashed border-line px-[var(--hw-gutter)] py-[calc(88*var(--u))]">
        <div class="max-w-[760px]">
          <div data-reveal-item><SectionLabel>{ui.notesEyebrow}</SectionLabel></div>
          <div data-reveal-item><SectionHeading as="h1" class="mt-4">{ui.notesTitle}</SectionHeading></div>
          <p data-reveal-item class="mt-5 max-w-[60ch] text-[var(--hw-text-body)] leading-relaxed text-muted">{ui.notesSubtitle}</p>
        </div>
      </section>

      <section class="w-full px-[var(--hw-gutter)] py-[calc(72*var(--u))]">
        {notes.length > 0 ? (
          <div data-reveal-group class="max-w-[900px] border-t border-dashed border-line">
            {notes.map((note) => (
              <article data-reveal-item class="border-b border-dashed border-line py-[calc(32*var(--u))]">
                <p class="eyebrow">{note.data.category}</p>
                <h2 class="display mt-3 text-[calc(24*var(--u))] text-ink">
                  <a class="hover:text-accent-strong" href={`/th/notes/${entrySlug(note.id)}/`}>{note.data.title}</a>
                </h2>
                <p class="mt-3 max-w-[70ch] text-[var(--hw-text-body)] leading-relaxed text-muted">{note.data.excerpt}</p>
                <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-[0.1em] text-muted">
                  <span>{ui.notesPublished}: {note.data.publishedAt}</span>
                  <span>{ui.notesReadTime}: {note.data.readTime}</span>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div data-reveal-group class="max-w-[900px] border border-dashed border-line p-10 text-center sm:p-14">
            <div data-reveal-item>
              <h2 class="display text-xl text-ink">{ui.notesEmptyTitle}</h2>
              <p class="mx-auto mt-3 max-w-[46ch] text-muted">{ui.notesEmptyBody}</p>
            </div>
          </div>
        )}
      </section>
    </main>
    <Footer lang={lang} />
  </div>
</BaseLayout>
