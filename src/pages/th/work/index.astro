---
import { loadProjects } from '@/lib/cms'
import { entrySlug } from '@/content.config'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import WorkIndex from '@/components/WorkIndex.astro'

const projects = (await loadProjects('th')).map((entry) => ({
  slug: entrySlug(entry.id),
  ...entry.data,
}))
---
<MainGridLayout lang="th" bannerEnabled={false} title="Work - Chinnakrit" description="โปรเจกต์และระบบที่คัดสรรโดยชินกฤต">
  <WorkIndex lang="th" projects={projects} />
</MainGridLayout>
