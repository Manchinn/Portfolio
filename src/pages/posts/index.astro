---
import { getCollection } from 'astro:content'
import type { Language } from '@/i18n/ui'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import PostsIndex from '@/components/PostsIndex.astro'

const lang: Language = 'en'
const posts = (await getCollection('articles', ({ id, data }) => id.startsWith('en/') && !data.draft))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
---
<MainGridLayout lang={lang} bannerEnabled={false} title="Posts - Chinnakrit" description="Posts, notes, and runbooks by Chinnakrit.">
  <PostsIndex lang={lang} posts={posts} basePath="/posts/" />
</MainGridLayout>
