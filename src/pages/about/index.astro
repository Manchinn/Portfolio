---
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
const lang: Language = 'en'
const ui = getUI(lang)
---
<MainGridLayout lang={lang} bannerEnabled={false} title={`About - ${ui.brand}`} description="About Chinnakrit, a builder documenting tools, workflows, and experiments.">
  <article class="card-base px-6 py-8 md:px-9 md:py-10">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary)]">{ui.nav.about}</p>
    <h1 class="text-3xl font-bold leading-tight text-90 md:text-5xl">A public record of how I build.</h1>
    <div class="mt-6 space-y-5 text-lg leading-relaxed text-75">
      <p>I am Chinnakrit. This site collects practical notes, runbooks, and project records from the systems I build and study.</p>
      <p>Each post is written after a review pass so the useful decisions, constraints, and outcomes are clear to future readers.</p>
      <p>The site is bilingual, static-first, and intentionally small. The public record stays focused on reproducible work and lessons learned.</p>
    </div>
  </article>
</MainGridLayout>
