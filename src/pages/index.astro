---
import { getCollection } from 'astro:content'
import { entrySlug } from '@/content.config'
import type { Language } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import HomePage from '@/components/home/HomePage.astro'

const lang: Language = 'en'

const projects = await getCollection('projects', ({ data }) => data.lang === lang)
const articles = await getCollection('articles', ({ data }) => data.lang === lang)

const project = projects[0]?.data
if (!project) {
  throw new Error('No English project entry found. Add src/content/projects/en/*.json')
}

const articleData = articles.map((entry) => ({
  slug: entrySlug(entry.id),
  title: entry.data.title,
  excerpt: entry.data.excerpt,
  category: entry.data.category,
  readTime: entry.data.readTime,
}))
---

<BaseLayout lang={lang}>
  <HomePage lang={lang} project={project} articles={articleData} />
</BaseLayout>
