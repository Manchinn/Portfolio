---
// Owner-only admin SPA inside the shared Fuwari shell (navbar, theme,
// footer, back-to-top) with the sidebar hidden for a full-width workspace.
// noindex is enforced via the layout chain (MainGridLayout -> Layout ->
// BaseLayout). All authorization happens server-side via RLS
// (is_editor/is_owner read the authenticated user's app_metadata.role).
// This page ships no secrets: it uses the publishable key only.
import MainGridLayout from '@/layouts/MainGridLayout.astro'
---
<MainGridLayout
  lang="en"
  bannerEnabled={false}
  sidebarEnabled={false}
  noindex={true}
  title="Admin — Chinnakrit"
  description="Owner-only content admin: submissions inbox plus projects/articles editing."
>
  <div id="admin-root">
    <section class="card-base onload-animation px-6 py-8 md:px-9 md:py-10 mb-4">
      <p class="eyebrow mb-3">Admin</p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight text-90">Content &amp; inbox</h1>
      <p class="text-50 mt-3" id="session-info"></p>
    </section>

    <!-- ============ LOGIN ============ -->
    <section id="view-login" class="card-base onload-animation p-5 md:p-7 mb-4">
      <h2 class="text-xl font-bold text-90">Sign in</h2>
      <form id="login-form" class="row" style="margin-top:1rem">
        <input type="email" id="login-email" placeholder="email" aria-label="Email" required autocomplete="username" style="max-width:280px" />
        <input type="password" id="login-password" placeholder="password" aria-label="Password" required autocomplete="current-password" style="max-width:200px" />
        <button type="submit">Sign in</button>
      </form>
      <p id="login-msg" class="muted" style="margin-top:.5rem" aria-live="polite"></p>
    </section>

    <!-- ============ APP ============ -->
    <div id="view-app" class="hidden">
      <div class="card-base onload-animation p-3 md:p-4 mb-4">
        <div class="row">
          <button data-tab="submissions" class="tab-btn primary" type="button">Submissions</button>
          <button data-tab="projects" class="tab-btn" type="button">Projects</button>
          <button data-tab="articles" class="tab-btn" type="button">Articles</button>
          <span style="flex:1"></span>
          <button id="btn-signout" type="button">Sign out</button>
        </div>
      </div>

      <!-- Submissions -->
      <div id="tab-submissions" class="card-base p-5 md:p-7 mb-4">
        <div class="row">
          <select id="sub-filter" aria-label="Filter submissions by status" style="max-width:180px">
            <option value="">all</option>
            <option value="new">new</option>
            <option value="in_progress">in_progress</option>
            <option value="resolved">resolved</option>
            <option value="spam">spam</option>
          </select>
          <button id="sub-reload" type="button">Reload</button>
        </div>
        <div class="table-wrap" style="margin-top:.75rem">
          <table>
            <thead><tr><th>When</th><th>From</th><th>Message</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead>
            <tbody id="sub-body"></tbody>
          </table>
        </div>
      </div>

      <!-- Projects / Articles -->
      <div id="tab-projects" class="hidden"></div>
      <div id="tab-articles" class="hidden"></div>
    </div>

    <p id="global-msg" class="muted" style="margin-top:1rem" aria-live="polite"></p>
  </div>

  <style is:global>
    /* Scoped under #admin-root: the editor forms/tables are rendered by
       client-side JS (innerHTML), so these must be global to match
       runtime-injected nodes. All colors come from the Fuwari tokens so
       light/dark mode follows the site theme toggle. */
    #admin-root .row { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
    #admin-root .muted { color: var(--color-muted); font-size: .8rem; }
    #admin-root .err { color: #c0392b; }
    #admin-root .ok { color: #1e8e3e; }
    :root.dark #admin-root .err { color: #f1948a; }
    :root.dark #admin-root .ok { color: #7bd88f; }
    #admin-root input, #admin-root textarea, #admin-root select {
      font: inherit;
      padding: .5rem .75rem;
      border: 1px solid var(--line-color);
      border-radius: .75rem;
      background: var(--btn-regular-bg);
      color: var(--color-ink);
      width: 100%;
      box-sizing: border-box;
      flex: 0 1 auto;
      min-width: 0;
    }
    #admin-root button {
      font: inherit;
      cursor: pointer;
      border: none;
      border-radius: .75rem;
      padding: .65rem 1.2rem;
      background: var(--btn-regular-bg);
      color: var(--btn-content);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
    }
    #admin-root button:hover { background: var(--btn-regular-bg-hover); }
    #admin-root button:active { background: var(--btn-regular-bg-active); transform: scale(.97); }
    #admin-root .tab-btn { background: transparent; color: var(--color-ink); }
    #admin-root .tab-btn:hover { color: var(--primary); background: var(--btn-plain-bg-hover); }
    #admin-root .tab-btn.primary { background: var(--btn-regular-bg); color: var(--btn-content); }
    #admin-root .table-wrap { overflow-x: auto; }
    #admin-root table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    #admin-root th, #admin-root td { text-align: left; padding: .55rem .5rem; border-bottom: 1px solid var(--line-divider); vertical-align: top; }
    #admin-root th { color: var(--color-muted); font-weight: 600; }
    #admin-root .admin-card { padding: 1.25rem; margin-bottom: 1rem; }
    @media (min-width: 768px) {
      #admin-root .admin-card { padding: 1.5rem 1.75rem; }
    }
    #admin-root #session-info:empty { display: none; }
    #admin-root .admin-slug { font-size: 1rem; font-weight: 700; margin: 0; color: var(--color-ink); overflow-wrap: anywhere; }
    #admin-root textarea { font-family: var(--font-mono); font-size: .85rem; }
    #admin-root .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }
  </style>

  <script>
    import { createBrowserClient } from '@/lib/supabase'
    import type { SupabaseClient } from '@supabase/supabase-js'

    const supabase: SupabaseClient = createBrowserClient()
    const $ = (id: string): HTMLElement => document.getElementById(id)!
    const msg = (text: string | null | undefined, cls = ''): void => {
      $('global-msg').textContent = text ?? ''
      $('global-msg').className = `muted ${cls}`
    }
    function escapeHtml(v: unknown): string {
      return String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c)
    }

    /* ---------- auth ---------- */
    function toggle(loggedIn: boolean, email = ''): void {
      $('view-login').classList.toggle('hidden', loggedIn)
      $('view-app').classList.toggle('hidden', !loggedIn)
      $('session-info').textContent = loggedIn ? `signed in as ${email}` : ''
      if (loggedIn) void reloadSubmissions()
    }
    async function refreshSession(): Promise<void> {
      const { data } = await supabase.auth.getSession()
      const session = data.session
      toggle(session != null, session?.user?.email ?? '')
    }
    ;($('login-form') as HTMLFormElement).addEventListener('submit', async (e: Event) => {
      e.preventDefault()
      const loginMsg = $('login-msg')
      loginMsg.textContent = ''
      loginMsg.className = 'muted'
      const { error } = await supabase.auth.signInWithPassword({
        email: ($('login-email') as HTMLInputElement).value.trim(),
        password: ($('login-password') as HTMLInputElement).value,
      })
      if (error) {
        loginMsg.textContent = error.message
        loginMsg.className = 'err'
        return
      }
      await refreshSession()
    })
    $('btn-signout').addEventListener('click', async () => {
      await supabase.auth.signOut()
      toggle(false)
    })

    /* ---------- tabs ---------- */
    ;(document.querySelectorAll('[data-tab]') as NodeListOf<HTMLButtonElement>).forEach((btn) =>
      btn.addEventListener('click', () => {
        ;(document.querySelectorAll('[data-tab]') as NodeListOf<HTMLButtonElement>).forEach((b) =>
          b.classList.toggle('primary', b === btn)
        )
        for (const id of ['submissions', 'projects', 'articles']) {
          $(`tab-${id}`).classList.toggle('hidden', id !== btn.dataset.tab)
        }
        if (btn.dataset.tab === 'projects' || btn.dataset.tab === 'articles') void renderContent(btn.dataset.tab)
      })
    )

    /* ---------- submissions ---------- */
    $('sub-reload').addEventListener('click', () => void reloadSubmissions())
    $('sub-filter').addEventListener('change', () => void reloadSubmissions())
    async function reloadSubmissions(): Promise<void> {
      let q = supabase.from('contact_submissions').select('*').order('created_at', { ascending: false }).limit(100)
      const filter = ($('sub-filter') as HTMLSelectElement).value
      if (filter) q = q.eq('status', filter)
      const { data, error } = await q
      if (error) return void msg(error.message, 'err')
      const body = $('sub-body') as HTMLElement
      body.innerHTML = ''
      for (const s of data ?? []) {
        const tr = document.createElement('tr')
        tr.innerHTML = `
          <td>${new Date(s.created_at).toLocaleString()}</td>
          <td>${escapeHtml(s.name)}<br><span class="muted">${escapeHtml(s.email)}${s.company ? ' · ' + escapeHtml(s.company) : ''}${s.budget ? ' · ' + escapeHtml(s.budget) : ''}</span><br><span class="muted">${escapeHtml(s.locale)}</span></td>
          <td style="max-width:340px">${escapeHtml(s.message)}</td>
          <td>
            <select data-id="${s.id}" class="sub-status" aria-label="Submission status">
              ${['new', 'in_progress', 'resolved', 'spam'].map((v) => `<option ${v === s.status ? 'selected' : ''}>${v}</option>`).join('')}
            </select>
          </td>
          <td><button type="button" data-del="${s.id}" class="sub-del">Delete</button></td>`
        body.appendChild(tr)
      }
      ;(document.querySelectorAll('.sub-status') as NodeListOf<HTMLSelectElement>).forEach((sel) =>
        sel.addEventListener('change', async () => {
          sel.disabled = true
          try {
            const { error } = await supabase
              .from('contact_submissions')
              .update({ status: sel.value })
              .eq('id', sel.dataset.id ?? '')
            msg(error ? error.message : 'status updated', error ? 'err' : 'ok')
          } finally {
            sel.disabled = false
          }
        })
      )
      ;(document.querySelectorAll('.sub-del') as NodeListOf<HTMLButtonElement>).forEach((btn) =>
        btn.addEventListener('click', async () => {
          if (!confirm('Delete this submission?')) return
          const { error } = await supabase.from('contact_submissions').delete().eq('id', btn.dataset.del ?? '')
          msg(error ? error.message : 'deleted', error ? 'err' : 'ok')
          void reloadSubmissions()
        })
      )
    }

    /* ---------- content (projects / articles) ---------- */
    async function renderContent(kind: 'projects' | 'articles'): Promise<void> {
      const host = $(`tab-${kind}`)
      host.innerHTML = '<p class="muted">loading…</p>'
      const ttable = kind === 'projects' ? 'project_translations' : 'article_translations'
      const fk = kind === 'projects' ? 'project_id' : 'article_id'
      const { data, error } = await supabase
        .from(kind)
        .select(`*, ${ttable}(*)`)
        .order('updated_at', { ascending: false })
      if (error) {
        host.innerHTML = `<p class="err">${escapeHtml(error.message)}</p>`
        return
      }
      host.innerHTML = ''
      for (const row of data ?? []) {
        const card = document.createElement('section')
        card.className = 'card-base admin-card'
        const dateLabel = kind === 'projects' ? (row.project_date ?? '') : (row.published_at?.slice(0, 10) ?? '')
        card.innerHTML = `<div class="row"><h3 class="admin-slug">${escapeHtml(row.slug)}</h3>
          <span class="muted">${escapeHtml(dateLabel)}</span>
          <select class="st" aria-label="Status for ${escapeHtml(row.slug)}">
            ${['draft', 'review', 'published', 'archived'].map((v) => `<option ${v === row.status ? 'selected' : ''}>${v}</option>`).join('')}
          </select>
          <span style="flex:1"></span><span class="muted">updated ${new Date(row.updated_at).toLocaleString()}</span></div>`
        const fields: Array<[string, string]> =
          kind === 'projects'
            ? [['title', 'Title'], ['description', 'Description'], ['category', 'Category'], ['problem', 'Problem'], ['built', 'Built'], ['result', 'Result']]
            : [['title', 'Title'], ['description', 'Description']]
        for (const t of row[ttable] ?? []) {
          const form = document.createElement('form')
          form.className = 'tr-form'
          form.style.marginTop = '.5rem'
          form.innerHTML = `
            <div class="row"><span class="muted">${escapeHtml(t.locale)}</span><span style="flex:1"></span>
              <button type="submit">save</button></div>
            ${fields.map(([k, label]) => `<label class="row" style="margin-top:.3rem"><span class="muted" style="width:90px">${label}</span>
              <input name="${k}" value="${escapeHtml(t[k] ?? '')}"/></label>`).join('')}
            ${kind === 'articles' ? `<label class="row" style="margin-top:.3rem"><span class="muted" style="width:90px">Body</span>
              <textarea name="body_markdown" rows="6">${escapeHtml(t.body_markdown ?? '')}</textarea></label>` : ''}`
          form.addEventListener('submit', async (e: Event) => {
            e.preventDefault()
            const saveBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')
            if (saveBtn?.disabled) return
            if (saveBtn) saveBtn.disabled = true
            try {
              const fd = new FormData(form)
              const patch: Record<string, unknown> = { locale: t.locale }
              for (const [k] of fields) patch[k] = fd.get(k)
              if (kind === 'articles') patch.body_markdown = fd.get('body_markdown')
              const { error: updateError } = await supabase
                .from(ttable)
                .update(patch)
                .eq(fk, row.id)
                .eq('locale', t.locale)
              msg(updateError ? updateError.message : `${row.slug}/${t.locale} saved`, updateError ? 'err' : 'ok')
            } finally {
              if (saveBtn) saveBtn.disabled = false
            }
          })
          card.appendChild(form)
        }
        const statusSel = card.querySelector('.st') as HTMLSelectElement
        statusSel.addEventListener('change', async () => {
          statusSel.disabled = true
          try {
            const { error: statusError } = await supabase
              .from(kind)
              .update({ status: statusSel.value })
              .eq('id', row.id)
            msg(statusError ? statusError.message : `${row.slug} → ${statusSel.value}`, statusError ? 'err' : 'ok')
          } finally {
            statusSel.disabled = false
          }
        })
        host.appendChild(card)
      }
      if ((data ?? []).length === 0) host.innerHTML = '<p class="muted">no rows</p>'
    }

    void refreshSession()
  </script>
</MainGridLayout>
