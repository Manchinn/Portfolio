---
import { loadProjects } from '@/lib/cms'
import { entrySlug } from '@/content.config'
import { getUI } from '@/i18n/ui'
import type { Language } from '@/i18n/ui'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import Markdown from '@/components/misc/Markdown.astro'

export async function getStaticPaths() {
  const projects = await loadProjects('en')
  return projects.map((project) => ({ params: { slug: entrySlug(project.id) }, props: { project } }))
}

const { project } = Astro.props
const lang: Language = 'en'
const ui = getUI(lang)
const caseStudy = project.data.caseStudy
---
<MainGridLayout lang={lang} bannerEnabled={false} title={`${project.data.title} - Work`} description={project.data.description}>
  <article class="card-base px-6 py-7 md:px-9 md:py-9">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary)]">{project.data.category}</p>
    <h1 class="mb-4 text-3xl font-bold leading-tight text-90 md:text-5xl">{project.data.title}</h1>
    {project.data.date && <p class="mb-5 text-sm font-medium text-50">{project.data.date}</p>}
    <p class="text-lg leading-relaxed text-75">{project.data.description}</p>

    {project.data.tech && project.data.tech.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {project.data.tech.map((tech) => <span class="btn-regular h-8 text-sm px-3 rounded-lg">{tech}</span>)}
      </div>
    )}

    <div class="mb-7 border-b border-dashed border-[var(--line-divider)]"></div>

    {caseStudy && (
      <div class="space-y-6">
        {([['problem', caseStudy.problem], ['built', caseStudy.built], ['result', caseStudy.result]] as const).map(([key, value]) => value && (
          <section>
            <h2 class="eyebrow text-accent">{ui.workCaseStudy[key]}</h2>
            <Markdown class="mt-2 text-muted">{value}</Markdown>
          </section>
        ))}
      </div>
    )}

    <div class="mt-8 border-t border-dashed border-[var(--line-divider)] pt-5">
      <a class="link text-sm font-medium" href="/work/">{ui.workBack}</a>
    </div>
  </article>
</MainGridLayout>
