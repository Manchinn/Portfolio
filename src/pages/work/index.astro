---
import { loadProjects } from '@/lib/cms'
import { entrySlug } from '@/content.config'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import WorkIndex from '@/components/WorkIndex.astro'

const projects = (await loadProjects('en')).map((entry) => ({
  slug: entrySlug(entry.id),
  ...entry.data,
}))
---
<MainGridLayout lang="en" bannerEnabled={false} title="Work - Chinnakrit" description="Selected systems and project case studies by Chinnakrit.">
  <WorkIndex lang="en" projects={projects} />
</MainGridLayout>
