---
import '@/styles/global.css'
import type { Language } from '@/i18n/ui'
import { getUI, META_DESCRIPTION } from '@/i18n/ui'
import ScrollMotion from '@/components/motion/ScrollMotion.astro'

interface Props {
  lang: Language
  title?: string
  description?: string
  ogType?: 'website' | 'article'
  canonical?: string
  noindex?: boolean
}

const { lang, title, description, ogType = 'website', canonical, noindex = false } = Astro.props
const ui = getUI(lang)
const htmlLang = lang === 'th' ? 'th' : 'en'
const SITE = Astro.site ?? new URL('https://www.chinnakrit.dev')
const pageTitle = title ?? `${ui.brand} — ${ui.footer}`
const pageDesc = description ?? META_DESCRIPTION[lang]
const canonicalUrl = canonical ?? Astro.url.href
const ogImage = new URL(`/og/og-${htmlLang}.png`, SITE)
const ogSiteName = 'chinnakrit.dev'
const ogLocale = lang === 'th' ? 'th_TH' : 'en_US'
const ogAlt =
  lang === 'th'
    ? 'การ์ดแนะนำตัว: บันทึก runbook และการทดลองของชินกฤต'
    : 'Intro card: notes, runbooks, and experiments by Chinnakrit.'

const origin = SITE.origin
const hrefLang = lang === 'en'
  ? [['en', `${origin}${Astro.url.pathname}`], ['th', `${origin}/th${Astro.url.pathname}`]]
  : [['th', `${origin}${Astro.url.pathname}`], ['en', `${origin}${Astro.url.pathname.replace(/^\/th/, '') || '/'}`]]
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && hrefLang.map(([h, path]) => (
      <link rel="alternate" hreflang={h} href={path} />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fafafa" />

    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
    <ScrollMotion />
  </body>
</html>
