---
import '@/styles/global.css'
import type { Language } from '@/i18n/ui'
import { getUI } from '@/i18n/ui'

interface Props {
  lang: Language
  title?: string
  description?: string
  ogType?: 'website' | 'article'
  canonical?: string
}

const { lang, title, description, ogType = 'website', canonical } = Astro.props
const ui = getUI(lang)
const htmlLang = lang === 'th' ? 'th' : 'en'
const pageTitle = title ?? `${ui.brand} — ${ui.footer}`
const pageDesc =
  description ??
  'Full-stack software engineer building clear, maintainable software from API to interface.'
const canonicalUrl = canonical ?? Astro.url.href

const hrefLang = lang === 'en'
  ? [['en', Astro.url.pathname], ['th', `/th${Astro.url.pathname}`]]
  : [['th', Astro.url.pathname], ['en', Astro.url.pathname.replace(/^\/th/, '') || '/']]
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />

    <link rel="canonical" href={canonicalUrl} />
    {hrefLang.map(([h, path]) => (
      <link rel="alternate" hreflang={h} href={path} />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fafafa" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Instrument+Serif:ital@0;1&family=Noto+Sans+Thai:wght@400;500;600;700&family=Noto+Serif+Thai:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
