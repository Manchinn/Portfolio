# ============================================
# Portfolio Environment Variables
# ============================================
# Copy to .env.local for local dev. Production values live on Vercel.
# Pull from Vercel: `vercel env pull .env.local`

# --- Admin auth ---
ADMIN_TOKEN=replace-with-admin-token

# --- AI providers (prompt + content generation) ---
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
GROQ_API_KEY=replace-with-groq-api-key
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
GOOGLE_AI_API_KEY=replace-with-google-ai-api-key

# --- GitHub (optional, raises rate limit for repo cards) ---
GITHUB_TOKEN=replace-with-github-token

# --- Threads publishing ---
THREADS_USER_ID=replace-with-threads-user-id
THREADS_ACCESS_TOKEN=replace-with-threads-access-token
THREADS_USERNAME=replace-with-threads-username

# --- Vercel Blob (auto-injected when project linked on Vercel) ---
# BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
