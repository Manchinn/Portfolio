# ============================================
# Portfolio Environment Variables
# ============================================

# API Configuration
# Set to 'true' to use API, 'false' to use static data
VITE_USE_API=false

# Backend API URL (change to your backend URL)
VITE_API_URL=http://localhost:3000/api

# Optional: API Authentication Token
# VITE_API_TOKEN=your_api_token_here
