# ============================================
# Portfolio Environment Variables
# ============================================
# Copy to .env.local for local dev. Production values live on Vercel.
# Pull from Vercel: `vercel env pull .env.local`

# No runtime environment variables are required by this app right now.

# Optional backend import tooling. Keep these server-only; never use PUBLIC_*.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
