# ============================================
# Portfolio Environment Variables
# ============================================
# Copy to .env.local for local dev. Production values live on Vercel.
# Pull from Vercel: `vercel env pull .env.local`

# --- Admin auth ---
ADMIN_TOKEN=

# --- AI providers (prompt + content generation) ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=
GOOGLE_AI_API_KEY=

# --- GitHub (optional, raises rate limit for repo cards) ---
GITHUB_TOKEN=

# --- Threads publishing ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_USERNAME=

# --- Vercel Blob (auto-injected when project linked on Vercel) ---
# BLOB_READ_WRITE_TOKEN=
